{
  "name": "movie-graphs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "lint": "oxlint",
    "prestart": "node tools/aspnetcore-https",
    "prepare": "pnpm dev-cert && pnpm prestart && dotnet build ../server && pnpm run openapi",
    "openapi": "tsx tools/openapi-gen.ts",
    "start": "run-script-os",
    "start:windows": "ng serve --port 4200 --ssl --ssl-cert \"%APPDATA%\\ASP.NET\\https\\%npm_package_name%.pem\" --ssl-key \"%APPDATA%\\ASP.NET\\https\\%npm_package_name%.key\"",
    "start:default": "ng serve --port 4200 --ssl --ssl-cert \"$HOME/.aspnet/https/${npm_package_name}.pem\" --ssl-key \"$HOME/.aspnet/https/${npm_package_name}.key\"",
    "start:sw": "run-script-os",
    "start:sw:windows": "http-server -p 4200 -c-1 dist/movie-graphs/browser -P https://localhost:4200? --proxy-options.secure false --ssl --cert \"%APPDATA%\\ASP.NET\\https\\%npm_package_name%.pem\" --key \"%APPDATA%\\ASP.NET\\https\\%npm_package_name%.key\"",
    "start:sw:default": "http-server -p 4200 -c-1 dist/movie-graphs/browser -P https://localhost:4200? --proxy-options.secure false --ssl --cert \"$HOME/.aspnet/https/${npm_package_name}.pem\" --key \"$HOME/.aspnet/https/${npm_package_name}.key\"",
    "dev-cert": "dotnet dev-certs https --trust",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@angular/common": "^22.2.2",
    "@angular/compiler": "^22.2.2",
    "@angular/core": "^22.2.2",
    "@angular/forms": "^22.2.2",
    "@angular/platform-browser": "^22.2.2",
    "@angular/router": "^22.2.2",
    "@ngneers/signal-translate": "22.0.0",
    "elkjs": "0.12.0",
    "immer": "^11.1.21",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "^22.6.0",
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.2",
    "@goast/core": "^0.6.0",
    "@goast/typescript": "^0.8.0",
    "@iconify-json/mdi": "^1.2.2",
    "@iconify/tailwind4": "^1.2.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/fs-extra": "^11.0.4",
    "eslint-plugin-ng-module-sort": "^1.4.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "fs-extra": "^11.2.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "postcss": "^8.5.30",
    "run-script-os": "^1.1.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@12.13.0"
}
